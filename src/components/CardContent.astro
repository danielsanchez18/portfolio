---
import TechBadge from "./TechBadge.astro"
import type { Project } from "./ProjectCard.astro"

export interface Props {
	project: Project
}

const { project: p } = Astro.props
---

<div class="relative overflow-hidden rounded-2xl">
	{p.thumbnail ? (
		<img src={p.thumbnail} alt={p.title} class="bg-accent w-full h-60 rounded-lg object-cover group-hover:scale-105 transition-transform duration-300" />
	) : (
		<div class="bg-accent w-full h-60 rounded-lg" />
	)}

	{p.url && (
		<div class="flex items-center justify-center absolute inset-0 bg-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
			<span class="bg-accent dark:text-white px-4 py-2 rounded-full text-xs border">Ver proyecto</span>
		</div>
	)}
</div>

<div class="space-y-4 py-2 mt-2">
	<div class="flex flex-wrap items-center gap-2">
		<span class="text-xs px-3 py-1 rounded-full font-mono border bg-white dark:bg-accent">{p.badge ?? p.year}</span>
		<span class="text-base">{p.title}</span>
	</div>
	<p class="text-accent-foreground text-sm">{p.description}</p>
	<div class="flex flex-wrap items-center gap-2">
		{p.tags.map((tag) => <TechBadge name={tag} />)}
	</div>
</div>
