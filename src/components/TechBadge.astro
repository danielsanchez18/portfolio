---
export interface Props {
	name: string
}

const techIcon: Record<string, { icon: string; invert?: boolean }> = {
	"Next.js": { icon: "/next-js.svg", invert: true },
	NestJS: { icon: "/NestJS.svg" },
	Prisma: { icon: "/prisma-orm.png" },
	PostgreSQL: { icon: "/postgresql.webp" },
	Angular: { icon: "/angular.webp" },
	SpringBoot: { icon: "/Spring_Boot.svg.webp" },
	MySQL: { icon: "/mysql.svg", invert: true },
	JWT: { icon: "/jwt.webp" },
	Astro: { icon: "/astrojs.svg" },
	Python: { icon: "/python.webp" },
	"Tailwind CSS": { icon: "/tailwind.webp" },
	ShadCN: { icon: "/shadcn.png", invert: true },
}

const { name } = Astro.props
const tech = techIcon[name]
---

<div class="text-sm px-2 py-1.5 rounded-full border bg-white dark:bg-accent flex items-center gap-x-0.5">
	{tech && (
		<img
			src={tech.icon}
			alt={name}
			class={`h-5 w-5 object-contain ${tech.invert ? "dark:invert" : ""}`}
		/>
	)}
	<span class="px-1">{name}</span>
</div>
