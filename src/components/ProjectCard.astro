---
import CardContent from "./CardContent.astro"

export interface Project {
	title: string
	year: string
	description: string
	tags: string[]
	thumbnail?: string
	badge?: string
	url?: string
}

export interface Props {
	project: Project
}

const { project: p } = Astro.props
---

{p.url ? (
	<a href={p.url} target="_blank" rel="noopener noreferrer" class="block h-full">
		<article class="
			bg-primary/2 dark:bg-primary/5 hover:bg-primary/5 dark:hover:bg-primary/8 backdrop-blur-sm text-accent-foreground p-3 text-sm 
			rounded-3xl border text-start flex flex-col h-full group
		">
			<CardContent project={p} />
		</article>
	</a>
) : (
	<article class="
		bg-primary/2 dark:bg-primary/5 hover:bg-primary/5 dark:hover:bg-primary/8 backdrop-blur-sm text-accent-foreground p-3 text-sm 
		rounded-3xl border text-start flex flex-col h-full group
	">
		<CardContent project={p} />
	</article>
)}
