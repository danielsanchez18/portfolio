---
import { ArrowRight } from "lucide-react";
---

<section class="w-full border-y border-border">
    <div class="w-full max-w-350 mx-auto px-5 py-20 space-y-20">
        
        <!-- Title -->
        <div class="space-y-2">
            <h3 class="text-3xl font-medium">Featured Work</h3>
            <p class="text-xl text-neutral-700 dark:text-neutral-400">A selection of projects that showcase my approach to design and development</p>
        </div>

        <!-- Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">

            <!-- Proyect Card -->
            <button class="text-start border border-boder hover:boder-black dark:hover:border-white hover:bg-accent/50 transition p-5 space-y-3 group">
                <div class="flex justify-between items-center">
                    <p class="font-medium text-xl line-clamp-1">Design System</p>
                    <ArrowRight className="opacity-0 group-hover:opacity-100 transition" />
                </div>
                
                <p class="font-medium text-neutral-700 dark:text-neutral-400">2025</p>
                <p class="line-clamp-3 my-5">
                    A comprehensive design system with 50+ components, detailed documentation, and accessibility guidelines.
                </p>
                <div class="flex flex-wrap items-center gap-x-2">
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        Design 
                    </div>
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        Development 
                    </div>
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        System 
                    </div>
                </div>
            </button>

            <button class="text-start border border-boder hover:boder-black dark:hover:border-white hover:bg-accent/50 transition p-5 space-y-3 group">
                <div class="flex justify-between items-center">
