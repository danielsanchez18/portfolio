---
import { ArrowRight } from "lucide-react";

export interface Project {
	title: string
	year: string
	description: string
	tags: string[]
	url?: string
}

export interface Props {
	projects: Project[]
	title?: string
	description?: string
}

const { projects, title = "Proyectos Destacados", description = "Una selección de proyectos que muestran mi enfoque en la arquitectura de software y el desarrollo fullstack." } = Astro.props
---

<section class="w-full border-y border-border">
    <div class="w-full max-w-350 mx-auto px-5 py-20 space-y-20">
        
        <div class="space-y-2">
            <h3 class="text-3xl font-medium">{title}</h3>
            <p class="text-xl text-neutral-700 dark:text-neutral-400">
                {description}
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
            {projects.map((p) => (
                <button class="text-start border border-border hover:border-black dark:hover:border-white hover:bg-accent/50 transition p-5 space-y-3 group">
                    <div class="flex justify-between items-center">
                        <p class="font-medium text-xl line-clamp-1">{p.title}</p>
                        <ArrowRight className="opacity-0 group-hover:opacity-100 transition" />
                    </div>
                    
                    <p class="font-medium text-neutral-700 dark:text-neutral-400">{p.year}</p>
                    <p class="line-clamp-3 my-5">{p.description}</p>
                    <div class="flex flex-wrap items-center gap-2">
                        {p.tags.map((tag) => (
                            <div class="px-3 py-2 bg-accent text-sm border border-border">{tag}</div>
                        ))}
                    </div>
                </button>
            ))}
        </div>
    </div>
</section>