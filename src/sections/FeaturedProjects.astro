                        Design 
                    </div>
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        Development 
                    </div>
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        System 
                    </div>
                </div>
            </button>

            <button class="text-start border border-boder hover:boder-black dark:hover:border-white hover:bg-accent/50 transition p-5 space-y-3 group">
                <div class="flex justify-between items-center">
                    <p class="font-medium text-xl line-clamp-1">Design System</p>
