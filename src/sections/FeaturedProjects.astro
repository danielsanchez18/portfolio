                </div>
                
                <p class="font-medium text-neutral-700 dark:text-neutral-400">2025</p>
                <p class="line-clamp-3 my-5">
                    A comprehensive design system with 50+ components, detailed documentation, and accessibility guidelines.
                </p>
                <div class="flex flex-wrap items-center gap-x-2">
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        Design 
                    </div>
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        Development 
                    </div>
                    <div class="px-3 py-2 bg-accent text-sm border border-border">
                        System 
                    </div>
                </div>
            </button>

        </div>
    </div>
</section>