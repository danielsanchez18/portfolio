---
import { Download } from "lucide-react";
---

<section class="w-full pt-20">
    <div class="w-full max-w-4xl mx-auto px-5 grid grid-cols-[1fr_auto] items-center h-80 sm:h-100">

        <article class="space-y-5">
            
            <div class="space-y-2">
                <p class="tracking-wide text-sm font-mono text-muted-foreground">Desarrollador de software</p>
                <h1 class="text-5xl font-semibold tracking-wide">Daniel Sánchez</h1>
            </div>

            <div class="flex items-center gap-x-3">
                <p class="text-muted-foreground">
                    Desarrollador de software con 
                    <span class="text-primary"> +2 años de experiencia </span> 
                    en la construcción de aplicaciones web y plataformas escalables. Especializado en el ciclo completo de desarrollo para entregar soluciones de software robustas, eficientes y centradas en el usuario.
                </p>
            </div>

            <div class="flex items-center gap-x-2">
                <a href="#proyectos" class="
                    bg-primary/5 hover:bg-primary/15 backdrop-blur-sm text-accent-foreground px-4 py-2 text-sm rounded-full
                    border z-10 inline-flex transition-colors duration-400 items-center gap-x-2
                    " aria-label="Ver proyectos destacados">
                    Ver Proyectos
                </a>
                <a href="/cv/Juan_Daniel_Sánchez_Pisfil_CV.pdf" target="_blank" rel="noopener noreferrer" class="
                    bg-primary/5 hover:bg-primary/15 backdrop-blur-sm text-accent-foreground px-4 py-2 text-sm rounded-full
                    border z-10 inline-flex transition-colors duration-400 items-center gap-x-2
                    " aria-label="Descargar currículum vitae">
                    <Download className="size-4" />
                    Descargar CV
                </a>
            </div>
        </article>

        <div class="max-sm:hidden w-60">
            <img class="ml-auto dark:hidden block h-60" src="/logo.svg" alt="Daniel Sánchez - Logo" fetchpriority="high" />
            <img class="ml-auto hidden dark:block h-60" src="/logo-dark.svg" alt="Daniel Sánchez - Logo" fetchpriority="high" />
        </div>
    </div>
</section>