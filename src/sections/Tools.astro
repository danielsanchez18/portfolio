---
interface Tool {
	name: string
	icon: string
	invert?: boolean
	bg?: boolean
}

const tools: Tool[] = [
	{ name: "Astro", icon: "/astrojs.svg", bg: true },
	{ name: "Next.js", icon: "/next-js.svg", invert: true },
	{ name: "NestJS", icon: "/NestJS.svg" },
	{ name: "SpringBoot", icon: "/Spring_Boot.svg.webp" },
	{ name: "Angular", icon: "/angular.webp" },
	{ name: "PostgreSQL", icon: "/postgresql.webp" },
	{ name: "Prisma", icon: "/prisma-orm.png" },
	{ name: "MySQL", icon: "/mysql.svg", bg: true },
]
---

<section class="w-full overflow-hidden pb-20">

    <div class="relative w-full max-w-4xl mx-auto overflow-hidden">
        

        <div class="marquee-track flex gap-12 w-max">
            {[...tools, ...tools].map((t) => (
                <div class="flex flex-col items-center gap-y-2 min-w-28">
                    <img
                        src={t.icon}
                        alt={t.name}
                        class={`h-10 w-10 object-contain ${t.invert ? "dark:invert" : ""} ${t.bg ? "rounded-full bg-white p-1" : ""}`}
                    />
                    <span class="text-sm text-muted-foreground">{t.name}</span>
                </div>
            ))}
        </div>

        <div>

        </div>

    </div>
</section>

<style>
	.marquee-track {
		animation: scroll 20s linear infinite;
	}

	@keyframes scroll {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}
</style>