---
import ProjectCard from "@/components/ProjectCard.astro"
import type { Project } from "@/components/ProjectCard.astro"

const featured: Project[] = [
	{
		title: "Escapify",
		year: "2026",
		description: "Infraestructura e-commerce multi-tenant moderna y escalable. Construida con un stack enfocado en rendimiento de servidor y tipado estricto.",
		tags: ["Next.js", "NestJS", "Prisma", "PostgreSQL", "JWT"],
		badge: "Build",
		thumbnail: "/projects/escapify.png",
	},
	{
		title: "Las Rocas Restaurante",
		year: "2026",
		description: "Plataforma e-commerce y sitio web institucional para el rubro gastronómico. Integra un flujo completo de ventas en línea con la identidad digital del restaurante.",
		tags: ["Angular", "SpringBoot", "MySQL", "JWT"],
		thumbnail: "/projects/lasrocas.png",
	},
	{
		title: "Epsel - Sistema de Gestión Operativa",
		year: "2026",
		description: "Plataforma de gestión y control operativo. Estructura backend robusta conectada a una interfaz de usuario dinámica para el manejo eficiente de procesos y lectura inteligente de datos.",
		tags: ["Angular", "SpringBoot", "MySQL", "JWT", "Python", "Microservicios", "OCR"],
		thumbnail: "/projects/epsel.png",
	},
	{
		title: "FoxCode - Website",
		year: "2026",
		description: "Sitio web oficial y landing page de alto rendimiento para mi propia startup tecnológica. Arquitectura orientada a la velocidad de carga y optimización SEO.",
		tags: ["Astro", "Tailwind CSS", "ShadCN"],
		badge: "2026",
		thumbnail: "/projects/foxcode.png",
		url: "https://www.foxcodepe.com/"
	},
	{
		title: "E-Commerce System (Backoffice)",
		year: "2026",
		description: "Panel de control centralizado y desacoplado para la administración integral de comercio electrónico. Diseñado para gestionar inventarios, productos y ventas de forma independiente a la interfaz final del cliente.",
		tags: ["Angular", "Tailwind CSS"],
		badge: "2025",
		thumbnail: "/projects/ecommerce.png",
		url: "https://ecommerce-system.netlify.app/dashboard"
	},
	{
		title: "MPCH - Sistema de Gestión de Practicantes",
		year: "2026",
		description: "Plataforma desarrollada para el control administrativo de practicantes. Administra el registro de universidades, asignación de vacantes por área y el seguimiento de asistencia (entradas y salidas), automatizando la emisión de certificados al cumplir las horas requeridas.",
		tags: ["Angular", "SpringBoot", "MySQL", "JWT"],
		badge: "2024",
		thumbnail: "/projects/mpch.png",
	},
]
---

<section id="proyectos" class="w-full">
    <div class="w-full max-w-4xl mx-auto px-5 pt-20 space-y-10">

        <div class="space-y-1">
            <h2 class="text-2xl text-primary">Proyectos Destacados</h2>
            <p class="text-muted-foreground">Una selección de proyectos que muestran mi enfoque en la arquitectura de software y el desarrollo fullstack.</p>
        </div>

        <div id="projects-grid" class="grid md:grid-cols-2 gap-5">
            {featured.map((project, i) => (
                <div class={i >= 4 ? "hidden more-item" : ""}>
                    <ProjectCard project={project} />
                </div>
            ))}
        </div>

        <div class="flex justify-center">
            <button
                id="toggle-projects"
                class="bg-primary/5 hover:bg-primary/15 backdrop-blur-sm text-accent-foreground px-4 py-2 text-sm rounded-full border z-10 "
                aria-label="Mostrar más proyectos"
                aria-expanded="false"
            >
                Ver más
            </button>
        </div>

    </div>
</section>

<script>
    const btn = document.getElementById("toggle-projects")
    const items = document.querySelectorAll(".more-item")

    btn?.addEventListener("click", () => {
        const expanded = btn.textContent === "Ver menos"
        items.forEach((el) => el.classList.toggle("hidden", expanded))
        btn.textContent = expanded ? "Ver más" : "Ver menos"
        btn.setAttribute("aria-expanded", String(!expanded))
    })
</script>
